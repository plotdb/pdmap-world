.pdmap-choropleth path
  stroke #fff
  stroke-width .2

.pdmap-dorling-circle
  stroke #fff
  stroke-width .3
  fill-opacity .85

#controls label
  white-space nowrap
#controls input[type=range]
  vertical-align middle
  width 96px

// equal columns: `flex-grow-1` alone keeps a content-sized basis, so the longer
// caption would make its map wider than the other one.
#maps > div
  flex 1 1 0
  min-width 0
