doctype html
html
  include @/@loadingio/bootstrap.ext/index.pug
  head
    +css("/assets/lib/bootstrap/main/dist/css/bootstrap.min.css")
    +css("/assets/lib/@loadingio/bootstrap.ext/main/index.min.css")
    +css("/css/index.css")
  body
    .w-100.p-4
      h4.mb-3 pdmap-world &mdash; choropleth &amp; dorling cartogram

      .small.text-muted.mb-2 every control below drives both maps, so the same settings can be compared on a whole-world layout and on a six-country one.
      .d-flex.flex-wrap.align-items-center.mb-2#controls
        .mr-3.mb-2
          button.btn.btn-sm.btn-primary#mode-toggle switch to dorling
        .mr-3.mb-2
          button.btn.btn-sm.btn-outline-secondary#reroll re-roll data
        .mr-3.mb-2: label.mb-0
          input(type="checkbox", checked)#opt-basemap
          |  basemap
        .mr-3.mb-2: label.mb-0
          input(type="checkbox")#opt-link
          |  link
        .mr-3.mb-2: label.mb-0
          |  gravity&nbsp;
          select.custom-select.custom-select-sm.d-inline-block.w-auto#opt-gravity
            option(value="centroid", selected) centroid
            option(value="center") center
        .mr-3.mb-2: label.mb-0
          |  strength&nbsp;
          input(type="range", min="0.01", max="1", step="0.01", value="0.15")#opt-strength
          span.small.text-muted#opt-strength-value 0.15
        .mr-3.mb-2: label.mb-0
          |  collide&nbsp;
          input(type="range", min="0", max="8", step="0.5", value="1.5")#opt-collide
          span.small.text-muted#opt-collide-value 1.5
        .mr-3.mb-2: label.mb-0
          input(type="checkbox", checked)#opt-auto
          |  auto radius
        .mr-3.mb-2: label.mb-0
          |  fill&nbsp;
          input(type="range", min="0.05", max="1", step="0.05", value="0.4")#opt-fill
          span.small.text-muted#opt-fill-value 0.40
        .mr-3.mb-2: label.mb-0
          |  max r&nbsp;
          input(type="range", min="0", max="40", step="1", value="0")#opt-radius
          span.small.text-muted#opt-radius-value none
        .mr-3.mb-2: label.mb-0
          input(type="checkbox", checked)#opt-bounds
          |  bounds
        .mr-3.mb-2: label.mb-0
          input(type="checkbox", checked)#opt-tooltip
          |  tooltip

      .d-flex.w-100#maps
        .mx-2
          .small.text-muted.mb-1 world &mdash; every country
          .aspect-ratio.ratio-3by2: svg#root-left.w-100.h-100.border.shadow
        .mx-2
          .small.text-muted.mb-1 east asia &mdash; the same map narrowed with `includes`
          .aspect-ratio.ratio-3by2: svg#root-right.w-100.h-100.border.shadow

      .mt-4
        h6 tests
        ul.list-unstyled.small.mb-0#tests
          li.text-muted running ...

    script(src="https://d3js.org/d3.v4.js")
    script(src="https://d3js.org/topojson.v2.min.js")
    script(src="https://d3js.org/d3-color.v1.min.js")
    script(src="https://d3js.org/d3-interpolate.v1.min.js")
    script(src="https://d3js.org/d3-scale-chromatic.v1.min.js")

    +script("/assets/lib/proxise/main/index.min.js")
    +script("/assets/lib/@loadingio/ldquery/main/index.min.js")
    +script("/assets/lib/@loadingio/debounce.js/main/index.min.js")
    +script("/assets/lib/pdmap-world/dev/index.min.js")
    +script("js/index.js")
